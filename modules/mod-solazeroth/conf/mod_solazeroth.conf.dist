#
# Sol'Azeroth : réglages du module mod-solazeroth (valeurs provisoires, à équilibrer en jeu)
#

[worldserver]

###################################################################################################
# VERSION DU JEU (refonte v3 décidée le 30/10/2026)
#
#    SolAzeroth.Version                    3 = Sol'Azeroth v3 : les systèmes v2 bâtis sur les niveaux, les ressources
#                                          et les talents (échelle, écart, défi extérieur, rangs de menace, affixes,
#                                          spécialisations, formation, banque…) ne sont pas chargés.
#                                          2 = ancienne v2 (repère v2-final du dépôt). Lu au démarrage du serveur.

SolAzeroth.Version = 3

#    SolAzeroth.V3.RegenVie                Pourcentage de la vie maximum rendu toutes les 2 secondes hors combat
#                                          (v3 ; la régénération selon l'Esprit est coupée, Rate.Health = 0.001).
#                                          Défaut : 3 (vie pleine en un peu plus d'une minute).

SolAzeroth.V3.RegenVie = 3

#    SolAzeroth.V3.ArmureParPoint          Armure = réduction fixe (v3) : chaque coup physique perd armure / cette valeur
#                                          points de dégâts. Défaut : 20 (100 d'armure retirent 5 points par coup).
#    SolAzeroth.V3.ArmureMinimum           Part du coup qui passe toujours l'armure, en %. Défaut : 25.

SolAzeroth.V3.ArmureParPoint = 20
SolAzeroth.V3.ArmureMinimum = 25

#    SolAzeroth.V3.MalusParPoint           Malus hors de sa puissance (v3) : dégâts infligés en moins, en %, par point de
#                                          puissance qui manque face au monstre combattu. Défaut : 2.
#    SolAzeroth.V3.MalusMax                Plafond de ce malus, en %. Défaut : 75.

SolAzeroth.V3.MalusParPoint = 2
SolAzeroth.V3.MalusMax = 75

#    SolAzeroth.V3.Rempart.Part            Kit du guerrier tank (v3, F3) : part des dégâts encaissés, après l'armure, versée
#                                          dans le Rempart, en %. Défaut : 25.
#    SolAzeroth.V3.Rempart.Plafond         Plafond du Rempart, en % de la vie maximale. Défaut : 30.
#    SolAzeroth.V3.Rempart.Fuite           Perte du Rempart hors combat, en % de la vie maximale toutes les 2 secondes.
#                                          Défaut : 1.
#    SolAzeroth.V3.Rempart.FrappeBouclier  Rempart gagné par Frappe du bouclier, en % de la vie maximale. Défaut : 5.

SolAzeroth.V3.Rempart.Part = 25
SolAzeroth.V3.Rempart.Plafond = 30
SolAzeroth.V3.Rempart.Fuite = 1
SolAzeroth.V3.Rempart.FrappeBouclier = 5


###################################################################################################
# RANG DE MENACE (sections 4.2 et 4.3)
#
#    SolAzeroth.Menace.Enable              1 = actif
#    SolAzeroth.Menace.PVParRang           Résistance des monstres par rang : dégâts subis divisés par (1 + valeur × rang)
#    SolAzeroth.Menace.DegatsParRang       Dégâts des monstres par rang : multipliés par (1 + valeur × rang)
#    SolAzeroth.Menace.OrParRang           Or ramassé par rang : multiplié par (1 + valeur × rang)
#    SolAzeroth.Menace.DonjonsPourDebloquer Nombre de donjons différents à réussir au rang N pour débloquer N + 1
#    SolAzeroth.Menace.PlafondClassiqueBC  Rang maximal des donjons Classic et Burning Crusade
#    SolAzeroth.Menace.PlafondWotLK        Rang maximal des donjons Wrath of the Lich King
#    SolAzeroth.Menace.PlafondRaid         Rang maximal des raids (calibrage final, 29/10/2026 : rang de menace en raid,
#                                          sans affixes de mécanique ; les réussites de raid ne débloquent pas de rang)

SolAzeroth.Menace.Enable = 1
SolAzeroth.Menace.PVParRang = 0.12
SolAzeroth.Menace.DegatsParRang = 0.10
SolAzeroth.Menace.OrParRang = 0.15
SolAzeroth.Menace.DonjonsPourDebloquer = 2
SolAzeroth.Menace.PlafondClassiqueBC = 5
SolAzeroth.Menace.PlafondWotLK = 10
SolAzeroth.Menace.PlafondRaid = 5

###################################################################################################
# AFFIXES (section 4.4) : Fortifié les semaines paires, Tyrannique les semaines impaires
#
#    SolAzeroth.Affixes.RangMin            Rang à partir duquel l'affixe s'applique
#    Fortifie : monstres (hors boss) ; Tyrannique : boss. PV et Degats en fraction (0.20 = +20 %)

SolAzeroth.Affixes.RangMin = 2
SolAzeroth.Affixes.Fortifie.PV = 0.20
SolAzeroth.Affixes.Fortifie.Degats = 0.20
SolAzeroth.Affixes.Tyrannique.PV = 0.30
SolAzeroth.Affixes.Tyrannique.Degats = 0.15

###################################################################################################
# BONUS SOLO PAR SPÉCIALISATION (section 3.5)
#
#    SolAzeroth.Solo.<Classe>.<Arbre> = "dégâts soins réduction"
#        Trois pourcentages : dégâts infligés en plus, soins reçus en plus, dégâts subis en moins.
#        La spécialisation est l'arbre de talents de sa propre classe qui a le plus de points (les talents d'une autre
#        classe ne comptent pas). Absent = "0 0 0".
#        Calibrage final (29/10/2026) : 15 % pour toutes les spés tank ; plus de bonus pour les soigneurs (le soin est un
#        confort pris en arbre secondaire, on ne monte pas de niveau en soigneur).

SolAzeroth.Solo.Guerrier.Protection = "15 0 0"
SolAzeroth.Solo.Paladin.Sacre = "0 0 0"
SolAzeroth.Solo.Paladin.Protection = "15 0 0"
SolAzeroth.Solo.Pretre.Discipline = "0 0 0"
SolAzeroth.Solo.Pretre.Sacre = "0 0 0"
SolAzeroth.Solo.ChevalierMort.Sang = "15 0 0"
SolAzeroth.Solo.Chaman.Restauration = "0 0 0"
SolAzeroth.Solo.Druide.Farouche = "15 0 0"
SolAzeroth.Solo.Druide.Restauration = "0 0 0"

###################################################################################################
# AJUSTEMENTS PAR CRÉATURE (valables partout, rang de menace ou non)
#
#    SolAzeroth.Ajustement.Creatures = "entrée fraction_PV fraction_dégâts, ..."
#        fraction des PV et des dégâts du jeu d'origine (0.5 = moitié). Exemple : boss de fête prévus pour 5 joueurs.
#        Cavalier sans tête (23682), sa tête (23775), Démons-citrouilles (23545), Citrouilles palpitantes (23694).

SolAzeroth.Ajustement.Creatures = "23682 0.5 0.3, 23775 0.5 0.3, 23545 0.5 0.3, 23694 0.5 1"

###################################################################################################
# MARQUE DU VOYAGEUR (section 7.5)
#
#    SolAzeroth.Marques.Boss          Marques par boss de donjon tué (+ le rang de menace de l'instance)
#    SolAzeroth.Marques.DernierBoss   Marques en plus pour le dernier boss d'un donjon
#    SolAzeroth.Marques.QueteNiveaux  Quête rendue : 1 marque + 1 tous les N niveaux du personnage

SolAzeroth.Marques.Boss = 2
SolAzeroth.Marques.DernierBoss = 5
SolAzeroth.Marques.QueteNiveaux = 40

#    SolAzeroth.Bonus.PourcentParRang  Enchantement de bonus : part des caractéristiques de l'objet ajoutée par rang de menace (0.03 = 3 %, au moins +1 par rang)

SolAzeroth.Bonus.PourcentParRang = 0.03

#    SolAzeroth.Amelioration.Prix     Marques du voyageur pour monter le rang d'un objet de 1 (calibrage final G6)
#    SolAzeroth.Amelioration.RangMax  Rang le plus haut atteignable avec des Marques (au-delà : donjons et raids)

SolAzeroth.Amelioration.Prix = 100
SolAzeroth.Amelioration.RangMax = 5

###################################################################################################
# DÉFIS DE BOSS (section 4.6) : un défi tiré au sort au début de chaque combat de boss de donjon
#
#    SolAzeroth.DefisBoss.Marques  Marques du voyageur gagnées si le défi est réussi
#    SolAzeroth.DefisBoss.Chrono   « Contre la montre » : durée maximale du combat, en secondes
#    SolAzeroth.DefisBoss.SeuilPV  « Intouchable » : pourcentage de PV sous lequel il ne faut pas descendre

SolAzeroth.DefisBoss.Enable = 1
SolAzeroth.DefisBoss.Marques = 3
SolAzeroth.DefisBoss.Chrono = 90
SolAzeroth.DefisBoss.SeuilPV = 50

