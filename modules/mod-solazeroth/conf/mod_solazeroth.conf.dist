SolAzeroth.Mecanique.Volcanique.Degats = 0.20
SolAzeroth.Mecanique.Explosif.Intervalle = 10
SolAzeroth.Mecanique.Explosif.Delai = 6
SolAzeroth.Mecanique.Explosif.PV = 0.12
SolAzeroth.Mecanique.Explosif.Degats = 0.15
