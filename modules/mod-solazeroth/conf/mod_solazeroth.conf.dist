SolAzeroth.Specialisations.Prix = "50 250 1000 4000"

#    SolAzeroth.DefiExterieur.PV       Résistance des monstres extérieurs, par niveau (1 à 7) : dégâts subis divisés par la valeur
#    SolAzeroth.DefiExterieur.Degats   Dégâts des monstres extérieurs, par niveau : multipliés par la valeur
#    SolAzeroth.DefiExterieur.XP       XP gagnée hors instance, par niveau : multipliée par la valeur
#    SolAzeroth.DefiExterieur.Or       Or ramassé hors instance, par niveau : multiplié par la valeur
#    SolAzeroth.DefiExterieur.Marques  Marques des quêtes rendues, par niveau : multipliées par la valeur
#    Le nombre de niveaux est celui de la plus courte liste (10 au plus). Niveau 5 : deux monstres à la fois demandent de la tactique.

SolAzeroth.DefiExterieur.PV = "1.15 1.35 1.55 1.75 2.00 2.30 2.60"
SolAzeroth.DefiExterieur.Degats = "1.10 1.25 1.45 1.70 2.00 2.30 2.60"
SolAzeroth.DefiExterieur.XP = "1.10 1.20 1.35 1.50 1.75 1.90 2.00"
SolAzeroth.DefiExterieur.Or = "1.10 1.20 1.35 1.50 1.75 1.90 2.00"
SolAzeroth.DefiExterieur.Marques = "1.10 1.20 1.30 1.40 1.50 1.60 1.70"

#    SolAzeroth.Intendant.MarquesBase       Prix en Marques d'un objet d'intendant : base + MarquesParNiveau × niveau requis
#    SolAzeroth.Intendant.MarquesParNiveau
#    SolAzeroth.Intendant.OrFacteur         Prix en or : niveau requis² × facteur, en pièces de cuivre (25 : 4 po au niveau 40)
#    SolAzeroth.Intendant.Rang              Rang de menace des objets achetés (enchantement de bonus)

SolAzeroth.Intendant.MarquesBase = 50
SolAzeroth.Intendant.MarquesParNiveau = 2.0
SolAzeroth.Intendant.OrFacteur = 75
SolAzeroth.Intendant.Rang = 3

#    SolAzeroth.Contrats.ParJour      Contrats ajoutés à la réserve du compte chaque jour (à 6 h)
