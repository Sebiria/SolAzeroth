# Affixes de mécanique à cocher (section 4.4, V5, valeurs provisoires) : fenêtre du rang (/rang)
#    Palier de butin = rang + points des affixes cochés, plafonné au rang maximal du donjon.
#
#    SolAzeroth.Mecanique.Enable                 Active les affixes de mécanique
#    SolAzeroth.Mecanique.<Affixe>.Points        Points de l'affixe (Enrage, Renforcant, Volcanique, Explosif)
#    SolAzeroth.Mecanique.Enrage.Seuil           Enragé : % de vie sous lequel un monstre (hors boss) s'enrage
#    SolAzeroth.Mecanique.Enrage.Degats          Enragé : dégâts en plus (0.5 = +50 %)
#    SolAzeroth.Mecanique.Renforcant.ParCumul    Renforçant : dégâts et PV en plus par cumul (0.2 = +20 %)
#    SolAzeroth.Mecanique.Renforcant.Portee      Renforçant : portée en mètres
#    SolAzeroth.Mecanique.Volcanique.Intervalle  Volcanique : secondes entre deux pluies de feu en combat
#    SolAzeroth.Mecanique.Volcanique.Degats      Volcanique : part des PV max retirée si on reste dedans (une impulsion, 0.15 = 15 %)
#    SolAzeroth.Mecanique.Explosif.Intervalle    Explosif : secondes entre deux sphères en combat
#    SolAzeroth.Mecanique.Explosif.Delai         Explosif : secondes avant l'explosion
#    SolAzeroth.Mecanique.Explosif.PV            Explosif : PV de la sphère, en part des PV max du joueur
#    SolAzeroth.Mecanique.Explosif.Degats        Explosif : part des PV max retirée par l'explosion

SolAzeroth.Mecanique.Enable = 1
SolAzeroth.Mecanique.Enrage.Points = 1
SolAzeroth.Mecanique.Renforcant.Points = 2
SolAzeroth.Mecanique.Volcanique.Points = 2
